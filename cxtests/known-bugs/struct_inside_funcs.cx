include <stdio.h>

// KNOWN-BUG (codegen): a struct defined inside a function body
// is accepted as a definition, but the type name is not visible
// at its use site. Declaring `Inner x;` inside the same function
// makes the generated C reference an unknown type 'Inner'.
//
// Expected today: C compile error "unknown type name 'Inner'".
// When codegen is fixed (hoist to file scope, or emit `struct
// Inner` at use sites), this test should compile and pass.

test "struct defined in function, used in same function" {
    struct Inner {
        int val;
    }

    Inner x;
    x.val = 42;
    printf("x.val=%d\n", x.val);
    return 0;
}