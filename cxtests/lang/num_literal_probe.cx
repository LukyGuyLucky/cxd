include <stdio.h>

// MANUAL PROBE — not part of `cx test`.
//
// Purpose: inspect how float and double literals are emitted into
// the generated C. Cx emits the source text of each literal
// verbatim; it does not re-format the parsed value.
//
// Verify:
//     cx num_literal_probe.cx --emit-c
//
// Expected in main():
//     float  a = 67.0f;
//     float  b = 0.1f;
//     double d = 3.14159;
//     double e = 100000000000.0;

int main() {
    float  a = 67.0f;
    float  b = 0.1f;
    double d = 3.14159;
    double e = 100000000000.0;
    printf("%f %f %f %f\n", a, b, d, e);
    return 0;
}