include <stdio.h>

struct Box<T> {
    T value;
}

struct Pair<A, B> {
    A first;
    B second;
}

struct Triple<A, B, C> {
    Pair<A, B> pair;
    C value;
}

struct Wrapper<T> {
    Box<T> box;
}

// 比 generics7 更深一层：Box<Wrapper<...>> 和 Wrapper<Pair<...>>
struct Deep2<A, B> {
    Wrapper<Pair<A,B>> value;
}

test "deep nested generic type" {
    printf("testing deep nested generic type\n");
    
    Deep2<int, float> x=.{};
    check(x.value.box.value.first==0 && x.value.box.value.second==0.0);
    
}