include <stdio.h>

enum FruitKind {
    Apple,
    Banana
}

union FruitData {
    i64 apple;
    double banana;
}

struct Favorite {
    FruitKind kind;
    FruitData data;
}

void print_favorite(Favorite f) {
    printf("kind = %d\n", __fieldGet(f, "kind"));
    if f.kind == FruitKind.Apple
        printf("data = apple(%lld)\n", __unionGet(f.data, "apple"));
    else if f.kind == FruitKind.Banana
        printf("data = banana(%f)\n", __unionGet(f.data, "banana"));
    else
        printf("data = <unknown tag>\n");

    printf("field count = %d\n", __fieldCount(Favorite));
}

test "reflect: metadata" {
    check_eq(__fieldCount(Favorite), 2);

    check(__fieldName(Favorite, 0) === "kind");
    check(__fieldName(Favorite, 1) === "data");
    check(__fieldType(Favorite, 0) === "FruitKind");
    check(__fieldType(Favorite, 1) === "FruitData");
}

test "reflect: union live arm" {
    Favorite a = .{ kind = FruitKind.Apple,  data = .{ apple  = 42   } };
    Favorite b = .{ kind = FruitKind.Banana, data = .{ banana = 3.14 } };

    check_eq(__fieldGet(a, "kind"), FruitKind.Apple);
    check_eq(__unionGet(a.data, "apple"), 42);

    check_eq(__fieldGet(b, "kind"), FruitKind.Banana);
    check_near(__unionGet(b.data, "banana"), 3.14, 0.0001);

    printf("--- a ---\n");
    print_favorite(a);
    printf("--- b ---\n");
    print_favorite(b);
}