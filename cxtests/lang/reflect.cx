include <stdio.h>

struct Vec3 {
    float x;
    float y;
    float z;
}

test "reflection basics" {
    check_eq(__sizeof(int), 4);
    check_eq(__alignof(int), 4);

    check_eq(__sizeof(Vec3), 12);
    check_eq(__alignof(Vec3), 4);

    check_eq(__sizeof(double), 8);
    check_eq(__alignof(double), 8);

    check_eq(__sizeof(int[3]), 12);
}