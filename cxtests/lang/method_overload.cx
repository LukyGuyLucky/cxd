include <stdio.h>

// Instance method overload by parameter type.
//
// Same method name, different parameter types, produces
// distinct symbols. The parser picks the overload by the
// argument's AST node type (IntLit -> int, FloatLit -> float,
// DoubleLit -> double, StringLit -> char*).
//
// The struct carries a real field. An empty struct is a
// zero-size type in C -- a GNU extension, not ISO C -- and an
// instance method needs something to point at. A struct with
// fields is that something.

struct Hello {
    int dummy;
    int hello(int i)    overload { printf("Hello %d\n", i); return 100; }
    int hello(float i)  overload { printf("Hello %f\n", i); return 200; }
    int hello(double i) overload { printf("Hello %f\n", i); return 300; }
    int hello(char* s)  overload { printf("Hello %s\n", s); return 400; }
}

test "instance method overload picks by AST type" {
    Hello h;
    check_eq(h.hello(67),         100);
    check_eq(h.hello(67.0f),      200);
    check_eq(h.hello(67.0),       300);
    check_eq(h.hello("sixSeven"), 400);
}