include <stdio.h>

struct Box<T> {
    T value;
}

struct Pair<A, B> {
    A first;
    B second;
}

struct Triple<A, B, C> {
    Pair<A, B> pair;
    C value;
}

struct Wrapper<T> {
    Box<T> box;
}

struct Deep<A, B> {
    Triple<
        Wrapper<A>,
        Pair<A, B>,
        Box<B>
    > value;
}

test "nested generics" {
    Triple<char*,int,float> record=.{
	pair=.{first="Adam",second=33},
	value=31.456
    };
    check(record.pair.first==="Adam");
    check(record.value-31.456<=0.0001);
    
    return 0;
}
