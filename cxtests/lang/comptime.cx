include <stdio.h>

int fib(int n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

int fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

test "fib and fact"{
    printf("testing comptime fib() and fact()\n");
    int f10 = __eval(fib(10));
    int f20 = __eval(fib(20));
    int ft  = __eval(fact(6));
    int x   = __eval(1 + 2 * 3);

    check_eq(fib(10),55);
    check_eq(fib(20),6765);
    check_eq(fact(6),720);
    check_eq(1+2*3,7);
    
    return 0;
}