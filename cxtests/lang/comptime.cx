include <stdio.h>

int fib(int n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

int fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

test "fib and fact"{
    int f10 = __eval(fib(10));
    int f20 = __eval(fib(20));
    int ft  = __eval(fact(6));
    int x   = __eval(1 + 2 * 3);

    printf("fib(10) = %d\n", f10);
    printf("fib(20) = %d\n", f20);
    printf("fact(6) = %d\n", ft);
    printf("1+2*3   = %d\n", x);
}