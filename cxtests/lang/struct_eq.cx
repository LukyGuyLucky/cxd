include <stdio.h>

struct Vec3 {
    float x, y, z;
    int cmp(Vec3 other) {
        if self.x == other.x && self.y == other.y && self.z == other.z
            return 1;
        return 0;
    }
}

test "operator === on UDT" {
    Vec3 v1 = .{ x = 1.0, y = 2.0, z = 3.0 };
    Vec3 v2 = .{ x = 1.0, y = 2.0, z = 3.0 };
    Vec3 v3 = .{ x = 1.0, y = 2.0, z = 4.0 };

    if v1 === v2 printf("v1 == v2\n");
    else printf("v1 != v2\n");

    if v1 === v3 printf("v1 == v3\n");
    else printf("v1 != v3\n");

    return 0;
}