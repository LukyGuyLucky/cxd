import std.io;
include "xlsxwriter.h"

int main() {
    //printf("Hello World!\n");

    test3();

    return 0;
}
void test1(){
    printf("test1-----\n");
    lxw_workbook* workbook=workbook_new("hello_world_cx.cx.xlsx");
    lxw_worksheet* worksheet=workbook_add_worksheet(workbook,NULL);
    
    worksheet_write_string(worksheet,0,0,"Hello",NULL);
    worksheet_write_number(worksheet,1,0,123,NULL);

    workbook_close(workbook);
}
void test2(){
    printf("test2---\n");
    lxw_workbook* workbook=workbook_new("demo.xlsx");
    lxw_worksheet* worksheet=workbook_add_worksheet(workbook,NULL);
    
    lxw_format* format=workbook_add_format(workbook);

    format_set_bold(format);

    worksheet_set_column(worksheet,0,0,20,NULL);

    worksheet_write_string(worksheet,0,0,"Hello",NULL);

    worksheet_write_string(worksheet,1,0,"Γειά σου Κόσμε!",format);

    worksheet_write_number(worksheet,2,0,123,NULL);
    worksheet_write_number(worksheet,3,0,123.456,NULL);
    worksheet_write_string(worksheet,4,0,"नमस्ते दुनिया!👋🌎!",format);
    worksheet_write_string(worksheet,5,0,"¡Hola Mundo!",format);
    worksheet_write_string(worksheet,6,0,"Привет, мир!",format);
    worksheet_write_string(worksheet,7,0,"こんにちは世界！",format);
    worksheet_write_string(worksheet,8,0,"你好世界！喜气洋洋！",format);
    worksheet_write_string(worksheet,9,0,"Hello World! Good Luck!",format);
    worksheet_insert_image(worksheet,1,2,"logo.png");

    workbook_close(workbook);
}
void test3(){
    printf("test3---\n");

    lxw_workbook* workbook=new_workbook("chart.xlsx");
    lxw_worksheet* worksheet=workbook_add_worksheet(workbook,NULL);

    write_worksheet_data(worksheet);

    lxw_chart* chart=workbook_add_chart(workbook,LXW_CHART_COLUMN);

    chart_add_series(chart,NULL,"Sheet1!$A$1:$A$5");
    chart_add_series(chart,NULL,"Sheet1!$B$1:$B$5");
    chart_add_series(chart,NULL,"Sheet1!$C$1:$C$5");

    worksheet_insert_chart(worksheet,CELL("B7"),chart);

    workbook_close(workbook);
}
void write_worksheet_data(lxw_worksheet* worksheet){
    u8[5][3] data={
        {1,2,3},
        {2,4,6},
        {3,6,9},
        {4,8,12},
        {5,10,15}    
    };

    for(int row=0;row<5;row++){
        for(int col=0;col<3;col++)
            worksheet_write_number(worksheet,row,col,data[row][col],NULL);    
    }    
}