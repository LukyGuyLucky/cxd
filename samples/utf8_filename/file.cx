// UTF-8 filenames with narrow char* on Windows
//
// Requires the exe to carry a manifest with
// <activeCodePage>UTF-8</activeCodePage>. See docs/manifest/ for
// the one-time setup that patches gcc's default-manifest.o.
//
// Without that setup, "Abkürzung - 副本.txt" is written to disk as
// "Abk眉rzung - 鍓湰.txt" because the path bytes are UTF-8 but the
// process code page is GBK.

import std.file;
import std.path;
import std.io;

int main() {
    char* testPath = "Abkürzung - 副本.txt";

    char* ext = Path.ext(testPath);
    printf("Extension: %s\n", ext);

    bool!FileError writeRes = File.writeText(testPath,
        "¡Hola Mundo!Γειά σου Κόσμε!Привет, мир!こんにちは世界！你好世界！नमस्ते दुनिया!👋🌎!");
    if !writeRes.valid {
        printf("Failed to write: %d\n", writeRes.error);
        return 1;
    }

    char*!FileError readRes = File.readText(testPath);
    if !readRes.valid {
        printf("Failed to read: %d\n", readRes.error);
        return 1;
    }

    char* content = readRes.ok;
    printf("File content: %s\n", content);

    free(content);
    return 0;
}