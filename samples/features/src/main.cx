}

u32 fast_add(u32 a, u32 b) {
    u32 result;
      __raw {
        __asm__ __volatile__(
            "addl %%ebx, %%eax"
            : "=a" (result)
            : "a" (a), "b" (b)
        );
    }
    return result;
}

u32 count_leading_zeros(u32 x)=> __builtin_clz(x);

u32 product_array(u32* restrict a,u32* restrict b,u32 n){
    u32 total=1;
    for(u32 i=0;i<n;i++){
        total*=a[i]*b[i];    
    }    
    return total;
}

struct Bar{
    union foo{
        int i;    
    }    
}
struct Foo{
    Bar bar;    
}
enum Switches{
    On,
    Off,
    WAITING    
}
struct Book{
    char* title;
    char* author;
    u32 published;

    static Book new()=>.{"Live","Liwes",2006};

    char* description(){
        char* result=malloc(512);
        sprintf(result,
            "Title:\t%s\n"
            "Author:\t%s\n"
            "Pushlished:\t%d\n\n",
            self.title,self.author,self.published
        );    
        return result;
    }
}



